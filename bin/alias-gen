#!/usr/bin/env bash

# ==============================================================================
# Script Name: alias-gen
# Description: Interactively create and append custom aliases for Bash, Zsh, or Fish
# Description: Custom Bash Scripts Suite Utility
# Copyright (c) 2026 sanguine6660
# Licensed under the MIT License
# ==============================================================================

# ANSI Color Codes & Styles
RESET="\033[0m"
BOLD="\033[1m"
DIM="\033[2m"
CYAN="\033[36m"
GREEN="\033[32m"
YELLOW="\033[33m"
RED="\033[31m"
BLUE="\033[34m"

# Modern Styled Header
clear
echo -e "${CYAN}┌──────────────────────────────────────────────┐${RESET}"
echo -e "${CYAN}│${RESET}          ${BOLD}${GREEN}⚡ ALIAS GENERATOR ⚡${RESET}          ${CYAN}│${RESET}"
echo -e "${CYAN}└──────────────────────────────────────────────┘${RESET}"
echo -e "${DIM}  Create and save custom shell shortcuts...${RESET}\n"

# Prompt for Alias Name
read -p "$(echo -e "${YELLOW}==>${RESET} Enter alias ${BOLD}name${RESET} (e.g.,up, gs): ")" ALIAS_NAME
if [ -z "$ALIAS_NAME" ]; then
    echo -e "${RED}Error:${RESET} Alias name cannot be empty."
    exit 1
fi

# Prompt for Command
read -p "$(echo -e "${YELLOW}==>${RESET} Enter the ${BOLD}command${RESET} to map it to: ")" ALIAS_CMD
if [ -z "$ALIAS_CMD" ]; then
    echo -e "${RED}Error:${RESET} Command cannot be empty."
    exit 1
fi

# Select Target Shell / Config File
echo -e "\n${CYAN}Select target shell configuration:${RESET}"
echo -e "  ${BOLD}1${RESET}) Bash (${DIM}~/.bashrc${RESET})"
echo -e "  ${BOLD}2${RESET}) Zsh (${DIM}~/.zshrc${RESET})"
echo -e "  ${BOLD}3${RESET}) Fish (${DIM}~/.config/fish/config.fish${RESET})"
read -p "$(echo -e "${YELLOW}==>${RESET} Choice [1-3]: ")" SHELL_CHOICE

case "$SHELL_CHOICE" in
    1)
        CONFIG_FILE="$HOME/.bashrc"
        ALIAS_SYNTAX="alias $ALIAS_NAME='$ALIAS_CMD'"
        RELOAD_CMD="source ~/.bashrc"
        ;;
    2)
        CONFIG_FILE="$HOME/.zshrc"
        ALIAS_SYNTAX="alias $ALIAS_NAME='$ALIAS_CMD'"
        RELOAD_CMD="source ~/.zshrc"
        ;;
    3)
        CONFIG_FILE="$HOME/.config/fish/config.fish"
        # Ensure fish config directory exists
        mkdir -p "$(dirname "$CONFIG_FILE")"
        ALIAS_SYNTAX="alias $ALIAS_NAME='$ALIAS_CMD'"
        RELOAD_CMD="source ~/.config/fish/config.fish"
        ;;
    *)
        echo -e "${RED}Error:${RESET} Invalid selection."
        exit 1
        ;;
esac

# Append alias to configuration file with comment block
echo -e "\n${DIM}Appending to $CONFIG_FILE...${RESET}"
{
    echo ""
    echo "# Custom alias generated by alias-gen"
    echo "$ALIAS_SYNTAX"
} >> "$CONFIG_FILE"

# Success feedback
echo -e "${GREEN}${BOLD}==> Success! Alias created:${RESET}"
echo -e "    ${CYAN}$ALIAS_SYNTAX${RESET}"
echo -e "\n${DIM}To apply changes immediately in your current session, run:${RESET}"
echo -e "    ${BOLD}$RELOAD_CMD${RESET}"
