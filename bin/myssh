#!/usr/bin/env bash

# ==============================================================================
# Script Name: myssh
# Description: Interactive SSH connection manager using a JSON configuration file
# Description: Custom Bash Scripts Suite Utility
# Copyright (c) 2026 sanguine6660
# Licensed under the MIT License
# ==============================================================================

CONFIG_FILE="$HOME/.ssh/connections.json"

# ANSI Color Codes & Styles
RESET="\033[0m"
BOLD="\033[1m"
DIM="\033[2m"
CYAN="\033[36m"
GREEN="\033[32m"
YELLOW="\033[33m"
RED="\033[31m"
BLUE="\033[34m"

# Function to check and install 'jq' on any Linux distribution
check_and_install_jq() {
    if ! command -v jq &> /dev/null; then
        echo -e "${YELLOW}==>${RESET} ${BOLD}jq${RESET} is required to parse connections.json, but it's not installed."
        echo -e "${YELLOW}==>${RESET} Detecting package manager to install it automatically..."

        if [ "$EUID" -ne 0 ]; then
            SUDO="sudo"
        else
            SUDO=""
        fi

        if command -v pacman &> /dev/null; then
            $SUDO pacman -Sy --noconfirm jq
        elif command -v apt-get &> /dev/null; then
            $SUDO apt-get update && $SUDO apt-get install -y jq
        elif command -v dnf &> /dev/null; then
            $SUDO dnf install -y jq
        elif command -v zypper &> /dev/null; then
            $SUDO zypper install -y jq
        elif command -v apk &> /dev/null; then
            $SUDO apk add --no-cache jq
        else
            echo -e "${RED}Error:${RESET} Could not automatically detect a supported package manager."
            echo "Please manually install 'jq' and try again."
            exit 1
        fi
    fi
}

# Run the dependency check
check_and_install_jq

# Check if config file exists
if [ ! -f "$CONFIG_FILE" ]; then
    echo -e "${RED}Error:${RESET} Connection file not found at ${DIM}$CONFIG_FILE${RESET}"
    echo -e "Please create it with your SSH connections array."
    exit 1
fi

# Modern Styled Header
clear
echo -e "${CYAN}┌──────────────────────────────────────────────┐${RESET}"
echo -e "${CYAN}│${RESET}         ${BOLD}${GREEN}⚡ SSH CONNECTION MANAGER ⚡${RESET}          ${CYAN}│${RESET}"
echo -e "${CYAN}└──────────────────────────────────────────────┘${RESET}"
echo -e "${DIM}  Reading destinations from connections.json...${RESET}\n"

# Read names into an array using jq
mapfile -t NAMES < <(jq -r '.[].name' "$CONFIG_FILE")

if [ ${#NAMES[@]} -eq 0 ]; then
    echo -e "${YELLOW}No connections found in your JSON file.${RESET}"
    exit 1
fi

PS3="$(echo -e "${BLUE}❯${RESET} Select a server to connect to: ")"
select name in "${NAMES[@]}" "Quit"; do
    if [ "$name" == "Quit" ]; then
        echo -e "\n${DIM}Exiting session manager. Goodbye!${RESET}"
        break
    elif [ -n "$name" ]; then
        # Extract user, host, and port for the selected name using jq
        USER=$(jq -r --arg n "$name" '.[] | select(.name == $n) | .user' "$CONFIG_FILE")
        HOST=$(jq -r --arg n "$name" '.[] | select(.name == $n) | .host' "$CONFIG_FILE")
        PORT=$(jq -r --arg n "$name" '.[] | select(.name == $n) | .port' "$CONFIG_FILE")

        # Fallback to port 22 if port is missing or null
        if [ -z "$PORT" ] || [ "$PORT" == "null" ]; then
            PORT=22
        fi

        echo -e "\n${GREEN}==>${RESET} Connecting to ${BOLD}${CYAN}$USER@$HOST${RESET} ${DIM}(Port: $PORT)${RESET}..."
        ssh "$USER@$HOST" -p "$PORT"
        break
    else
        echo -e "${RED}Invalid choice. Please pick a valid number.${RESET}"
    fi
done
